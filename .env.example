# Local development only; matches infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://agentos:agentos@127.0.0.1:55432/agentos
TEST_DATABASE_URL=postgresql+asyncpg://agentos:agentos@127.0.0.1:55433/agentos_test
REDIS_URL=redis://127.0.0.1:56379/0
TEST_REDIS_URL=redis://127.0.0.1:56380/0
REDIS_QUEUE_KEY=agentos:tasks
DISPATCH_INTERVAL_SECONDS=1
REDISPATCH_SECONDS=30
DISPATCH_BATCH_SIZE=50

# Agent mode is explicit per task: execution_mode="agent".
# Keep this key only in your local .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SANDBOX_IMAGE=agentos-sandbox:0.1
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_COMMAND_TIMEOUT_SECONDS=30
AGENT_MAX_RUNTIME_SECONDS=600
